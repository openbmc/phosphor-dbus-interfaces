      "author": {
        "id": 1000056
      },
      "writtenOn": "2026-07-29T02:39:14Z",
      "side": 1,
      "message": "If a service fails to read the sensor, is it supposed to modify prior UpdateTime valur or not?",
      "range": {
        "startLine": 50,
        "startChar": 65,
        "endLine": 50,
        "endChar": 70
      },
      "revId": "5374993b5ee9ad3c1da2bff2215bab1e9ba7945d",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
    },
    {
