      "writtenOn": "2026-10-25T14:06:14Z",
      "side": 1,
      "message": "When these services create the inventory object, they should already have access to the necessary EM config? If so, what purpose does the association further serve?",
      "range": {
        "startLine": 4,
        "startChar": 67,
        "endLine": 5,
        "endChar": 22
      },
      "revId": "c751b750d1e22b70f80453d4e1bc3157679b51a6",
