      "writtenOn": "2026-09-30T06:03:48Z",
      "side": 1,
      "message": "How is this managed - bmcweb is supposed to do this?",
      "range": {
        "startLine": 44,
        "startChar": 77,
        "endLine": 45,
        "endChar": 49
      },
      "revId": "67a79b28ed1ae466f5cec71506827ef5e0094750",
