      "key": {
        "uuid": "432e1b2e_e1331dc6",
        "filename": "yaml/xyz/openbmc_project/Software/RebootBlocksNewUpdates.interface.yaml",
        "patchSetId": 2
      },
      "lineNbr": 5,
      "author": {
        "id": 1003117
      },
      "writtenOn": "2026-10-08T11:19:10Z",
      "side": 1,
      "message": "The pending BMC reboot is deferred specifically to avoid interrupting device updates already in progress. Without blocking, a new device update that starts during that window is also waited on, so a steady stream keeps pushing the reboot out — up to the fallback timeout, which would then fire mid-write and cause the very interruption we\u0027re trying to avoid. Blocking new updates while a reboot is pending bounds the wait to the updates already running, so the deferred reboot proceeds cleanly once they finish; it also avoids starting an update that\u0027s about to be cut off by the reboot.",
      "parentUuid": "3a9fdd4f_687ce42d",
      "revId": "2259fe434f82310cd97a400f23f7cc8936c4b0c1",
      "serverId": "adbd0a64-1f21-4d83-b585-671fe73cb6e4"
    },
