    },
    {
      "unresolved": false,
      "key": {
        "uuid": "0407e14f_c93645cc",
        "filename": "yaml/xyz/openbmc_project/Configuration/Object.interface.yaml",
        "patchSetId": 3
      },
      "lineNbr": 5,
